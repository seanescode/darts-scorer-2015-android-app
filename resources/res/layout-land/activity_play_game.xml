<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r"
    android:background="#ff621664"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textSize="35sp"
        android:textStyle="bold"
        android:textColor="#fffffbf9"
        android:gravity="center"
        android:id="@+id/scoredTxtBox"
        android:background="#000000"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:layout_marginTop="26dp"
        android:layout_below="@+id/player2Display"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="#ffffffff"
        android:id="@+id/player1Display"
        android:background="#ff2b1629"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/player_1"
        android:layout_alignBaseline="@+id/remainingP1TxtBox"
        android:layout_alignBottom="@+id/remainingP1TxtBox"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="#ffffffff"
        android:id="@+id/player2Display"
        android:background="#ff614962"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/player_2"
        android:layout_below="@+id/player1Display"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="15sp"
        android:textStyle="italic|bold"
        android:textColor="#ffffffff"
        android:id="@+id/scoreLeftTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/score_left_heading"
        android:layout_alignLeft="@+id/remainingP1TxtBox"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="15sp"
        android:textStyle="italic|bold"
        android:textColor="#ffffffff"
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/player_heading"
        android:layout_alignBaseline="@+id/legsTag"
        android:layout_alignBottom="@+id/legsTag"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/legsP1TxtBox"
        android:background="#000000"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/remainingP1TxtBox"
        android:layout_alignTop="@+id/player1Display"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/legsP2TxtBox"
        android:background="#000000"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/remainingP2TxtBox"
        android:layout_alignTop="@+id/player2Display"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="15sp"
        android:textStyle="italic|bold"
        android:textColor="#ffffffff"
        android:id="@+id/legsTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/legs_heading"
        android:layout_alignLeft="@+id/legsP1TxtBox"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/remainingP2TxtBox"
        android:background="#000000"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/legsP2TxtBox"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/remainingP1TxtBox"
        android:background="#000000"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/scoreLeftTag"
        android:layout_alignParentRight="true"/>
    <Button
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:id="@+id/btnStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start"
        android:layout_alignBottom="@+id/scoredTxtBox"
        android:layout_alignParentRight="true"/>
    <Button
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#fffefdff"
        android:id="@+id/btnStop"
        android:background="#ffff171b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stop"
        android:layout_below="@+id/scoredTxtBox"
        android:layout_alignRight="@+id/remainingP2TxtBox"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ffffffff"
        android:id="@+id/textViewTime"
        android:background="#fffd5aff"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_below="@+id/scoredTxtBox"
        android:layout_alignParentLeft="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_below="@+id/textViewTime"
        android:layout_alignParentLeft="true">
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_one"
            android:layout_weight="1"
            android:onClick="inputScore"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_two"
            android:layout_weight="1"
            android:onClick="inputScore"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_three"
            android:layout_weight="1"
            android:onClick="inputScore"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linearLayout2"
        android:layout_alignParentLeft="true">
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_four"
            android:layout_weight="1"
            android:onClick="inputScore"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_five"
            android:layout_weight="1"
            android:onClick="inputScore"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_six"
            android:layout_weight="1"
            android:onClick="inputScore"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linearLayout3"
        android:layout_alignParentLeft="true">
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_seven"
            android:layout_weight="1"
            android:onClick="inputScore"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_eight"
            android:layout_weight="1"
            android:onClick="inputScore"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_nine"
            android:layout_weight="1"
            android:onClick="inputScore"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linearLayout4"
        android:layout_alignParentLeft="true">
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/del_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/del_button"
            android:layout_weight="1"
            android:onClick="deleteClicked"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/num_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/num_zero"
            android:layout_weight="1"
            android:onClick="inputScore"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/enter_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/enter_button"
            android:layout_weight="1"
            android:onClick="onEnterClicked"/>
    </LinearLayout>
    <Button
        android:id="@+id/button10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stats"
        android:layout_toRightOf="@+id/scoredTxtBox"
        android:layout_alignTop="@+id/scoredTxtBox"
        android:layout_alignRight="@+id/textViewTime"
        android:onClick="onClick"/>
</RelativeLayout>
