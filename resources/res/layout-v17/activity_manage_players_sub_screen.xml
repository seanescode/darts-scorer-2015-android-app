<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/myRelativeLayout"
    android:background="#000"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/editNameHorLayout"
        android:paddingLeft="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <TextView
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="18sp"
            android:textColor="#fff"
            android:id="@+id/editNameTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/editNameTag"
            android:layout_weight="35"
            android:textIsSelectable="false"/>
        <EditText
            android:textColor="#fff"
            android:textColorHint="#fff"
            android:id="@+id/playerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Name"
            android:ems="10"
            android:layout_weight="65"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:inputType="textPersonName"
            android:textCursorDrawable="@null"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/butttonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_below="@+id/editNameHorLayout">
        <Button
            android:textSize="20sp"
            android:id="@+id/updateNameButton"
            android:background="@drawable/highlight_blue_to_white"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:text="@string/updateName"
            android:layout_weight="1"
            android:layout_below="@+id/playerName"
            android:layout_alignLeft="@+id/playerName"
            android:onClick="onClickUpdateName"
            android:layout_alignStart="@+id/playerName"/>
        <Button
            android:textSize="20sp"
            android:id="@+id/playerStatsButton"
            android:background="@drawable/highlight_blue_to_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:text="@string/playerStats"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
