<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/myrelativelayout"
    android:background="#000"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/containerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp">
        <TableLayout
            android:orientation="vertical"
            android:id="@+id/gameSetupVerticalLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="55">
            <TableRow
                android:id="@+id/tr1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textColor="#fff"
                    android:gravity="center_vertical"
                    android:id="@+id/textView2"
                    android:paddingLeft="10dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/numLegs"
                    android:layout_weight="3"/>
                <Button
                    android:id="@+id/numLegs"
                    android:background="@drawable/highlight_blue_to_white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:drawableRight="@drawable/downicon"
                    android:layout_weight="2"
                    android:onClick="onClickNumLegs"/>
            </TableRow>
            <TableRow
                android:id="@+id/tr2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textColor="#fff"
                    android:gravity="center_vertical"
                    android:id="@+id/textView6"
                    android:paddingLeft="10dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/startScore"
                    android:layout_weight="3"/>
                <Button
                    android:id="@+id/startScore"
                    android:background="@drawable/highlight_blue_to_white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:drawableRight="@drawable/downicon"
                    android:layout_weight="2"
                    android:onClick="onClickStartingScore"/>
            </TableRow>
            <TableRow
                android:id="@+id/timerModeTableRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textColor="#fff"
                    android:gravity="center_vertical"
                    android:id="@+id/textView24"
                    android:paddingLeft="10dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/timerMode"
                    android:layout_weight="3"/>
                <ToggleButton
                    android:id="@+id/useTimer"
                    android:background="@drawable/highlight_blue_to_white"
                    android:paddingRight="30dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:checked="false"
                    android:layout_weight="2"
                    android:layout_below="@+id/gameSetupVerticalLayout"
                    android:layout_alignParentRight="true"/>
            </TableRow>
            <TableRow
                android:id="@+id/timePerShotTableRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textColor="#fff"
                    android:gravity="center_vertical"
                    android:id="@+id/timePerShotTv"
                    android:paddingLeft="10dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/timerPerShot"
                    android:layout_weight="3"/>
                <Button
                    android:id="@+id/timePerShot"
                    android:background="@drawable/highlight_blue_to_white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:drawableRight="@drawable/downicon"
                    android:layout_weight="2"
                    android:onClick="onClickTimePerShot"/>
            </TableRow>
            <TableRow
                android:id="@+id/timeoutPenaltyTableRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textColor="#fff"
                    android:gravity="center_vertical"
                    android:id="@+id/timeoutPenaltyTv"
                    android:paddingLeft="10dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/penaltyForTimeout"
                    android:layout_weight="3"/>
                <Button
                    android:id="@+id/timeoutPeno"
                    android:background="@drawable/highlight_blue_to_white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:drawableRight="@drawable/downicon"
                    android:layout_weight="2"
                    android:onClick="onClickTimeoutPenalty"/>
            </TableRow>
        </TableLayout>
        <TableLayout
            android:orientation="vertical"
            android:id="@+id/fillerLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="35"/>
        <TableRow
            android:orientation="vertical"
            android:id="@+id/bottomVerticalLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_weight="10">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/bottomHorLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:id="@+id/filler"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="70"/>
                <Button
                    android:id="@+id/button4"
                    android:background="@drawable/highlight_blue_to_white"
                    android:padding="5dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/playGame"
                    android:layout_weight="30"
                    android:layout_alignRight="@+id/gameSetupVerticalLayout"
                    android:layout_alignParentBottom="true"
                    android:onClick="goToPlayGame"/>
            </LinearLayout>
        </TableRow>
    </LinearLayout>
</RelativeLayout>
