<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp"/>
            <stroke
                android:width="1dp"
                android:color="#ffdd1eff"/>
            <gradient
                android:startColor="#ff621764"
                android:endColor="#ff621764"
                android:angle="-90"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp"/>
            <stroke
                android:width="1dp"
                android:color="#5e7974"/>
            <solid android:color="#58857e"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="180dp"/>
            <stroke
                android:width="1dp"
                android:color="#ff621764"/>
            <gradient
                android:startColor="#e37fd7"
                android:endColor="#a3dd1eff"
                android:angle="-180"/>
        </shape>
    </item>
</selector>
