<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="8"
    android:versionName="1.25"
    package="com.sean_redmond.darts_scorer"
    platformBuildVersionCode="21"
    platformBuildVersionName="5.0.1-1624448">
    <uses-sdk
        android:minSdkVersion="14"
        android:targetSdkVersion="21"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true">
        <activity
            android:name="com.sean_redmond.darts_scorer.MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:label="@string/title_activity_play_game"
            android:name="com.sean_redmond.darts_scorer.play_game"
            android:screenOrientation="portrait"/>
        <activity
            android:label="@string/title_activity_game_setup"
            android:name="com.sean_redmond.darts_scorer.game_setup"
            android:screenOrientation="portrait"/>
        <activity
            android:label="@string/title_activity_instructions_screen"
            android:name="com.sean_redmond.darts_scorer.InstructionsScreen"
            android:screenOrientation="portrait"/>
        <activity
            android:label="@string/title_activity_new_player"
            android:name="com.sean_redmond.darts_scorer.newPlayer"
            android:screenOrientation="portrait"/>
        <activity
            android:label="@string/title_activity_select_player"
            android:name="com.sean_redmond.darts_scorer.SelectPlayer"
            android:screenOrientation="portrait"/>
        <activity
            android:label="@string/title_activity_stats_screen"
            android:name="com.sean_redmond.darts_scorer.StatsScreen"
            android:screenOrientation="portrait"/>
        <activity
            android:label="@string/title_activity_manage_players"
            android:name="com.sean_redmond.darts_scorer.ManagePlayers"
            android:screenOrientation="portrait"/>
        <activity
            android:label="@string/title_activity_manage_players_sub_screen"
            android:name="com.sean_redmond.darts_scorer.ManagePlayersSubScreen"
            android:screenOrientation="portrait"/>
        <activity
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:label="@string/title_activity_player_stats"
            android:name="com.sean_redmond.darts_scorer.PlayerStats"
            android:screenOrientation="portrait"/>
        <activity
            android:label="@string/title_activity_game_statistics"
            android:name="com.sean_redmond.darts_scorer.GameStatistics"
            android:screenOrientation="portrait"/>
        <activity
            android:theme="@android:style/Theme.Translucent"
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="smallestScreenSize|screenSize|uiMode|screenLayout|orientation|keyboardHidden|keyboard"/>
        <activity
            android:theme="@style/Theme.IAPTheme"
            android:name="com.google.android.gms.ads.purchase.InAppPurchaseActivity"/>
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version"/>
    </application>
</manifest>
